{
  "name":"uhs-platform","private":true,"version":"2.0.0",
  "workspaces":["client","server","shared"],
  "scripts":{"setup":"node scripts/setup-dev.mjs","predev":"npm run setup","dev":"concurrently -n client,server -c blue,green \"npm:dev -w client\" \"npm:dev -w server\"","build":"npm run build -w shared && npm run build -w server && npm run build -w client","db:generate":"prisma generate --schema prisma/schema.prisma","db:migrate":"prisma migrate dev --schema prisma/schema.prisma","db:push":"prisma db push --schema prisma/schema.prisma","db:seed":"npm run seed -w server"},
  "devDependencies":{"concurrently":"^9.2.1","prisma":"^6.12.0"}
}
